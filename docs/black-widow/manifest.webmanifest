{
  "name": "Black Widow: Thread by Thread",
  "short_name": "Black Widow",
  "description": "Be a black widow spider: sail away on a thread of silk, build a web thread by thread, and feel what is in it in the dark. A reading game for children.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#101830",
  "theme_color": "#101830",
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
